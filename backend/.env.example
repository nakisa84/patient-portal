# Copy to backend/.env and fill in. backend/.env is git-ignored.

# Same publishable key as frontend/.env.local (pk_test_...). The backend reads
# the Clerk issuer URL from it. This key is not secret.
CLERK_PUBLISHABLE_KEY=

# Websites allowed to call this API with a Clerk token (comma separated).
AUTHORIZED_PARTIES=http://localhost:5173

# Used from step 5 (uploads).
GCS_BUCKET=patient-portal-nakisa-data
